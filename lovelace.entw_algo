  "key": "lovelace.entw_algo",
  "data": {
    "config": {
      "views": [
        {
          "title": "Simulation",
          "path": "sim",
          "cards": [
            {
              "type": "entities",
              "title": "Schicht 1: Sensoren",
              "state_color": true,
              "entities": [
                {
                  "entity": "input_select.sim_modus_2",
                  "name": "Modus"
                },
                {
                  "entity": "input_number.sim_pv_erzeugung",
                  "name": "PV (kW)"
                },
                {
                  "entity": "input_number.sim_netz",
                  "name": "Netz (kW)"
                },
                {
                  "entity": "input_number.sim_batterie_leistung",
                  "name": "Batterie (kW)"
                },
                {
                  "entity": "input_number.sim_batterie_soc",
                  "name": "Batterie (%)"
                },
                {
                  "entity": "input_number.sim_wallbox_strom",
                  "name": "Wallbox Strom (A)"
                },
                {
                  "entity": "input_boolean.sim_wallbox_ein",
                  "name": "Wallbox aus/ein"
                },
                {
                  "entity": "input_select.sim_connector",
                  "name": "Connector"
                }
              ]
            },
            {
              "type": "entities",
              "title": "Schicht 2: Betriebsparameter",
              "state_color": true,
              "entities": [
                {
                  "entity": "input_select.sim_betriebsart",
                  "name": "Betriebsart"
                },
                {
                  "entity": "input_number.verzoegerung_wechsel",
                  "name": "Verz\u00f6gerung Wechsel"
                }
              ]
            },
            {
              "type": "vertical-stack",
              "title": "Schicht 3: Berechnete Sensoren",
              "cards": [
                {
                  "type": "entities",
                  "title": "",
                  "state_color": true,
                  "entities": [
                    {
                      "entity": "sensor.fahrzeug_status",
                      "name": "Fahrzeug"
                    },
                    {
                      "entity": "sensor.sim_zeit_seit_wechsel",
                      "name": "Zeit seit Wechsel"
                    },
                    {
                      "entity": "sensor.vergleichswert_aufwaerts",
                      "name": "Vergleich \u2191 (UP)"
                    },
                    {
                      "entity": "sensor.vergleichswert_abwaerts",
                      "name": "Vergleich \u2193 (DOWN)"
                    }
                  ]
                },
                {
                  "type": "markdown",
                  "content": "{{ states('sensor.aktuelle_ubergange') }}"
                }
              ]
            },
            {
              "type": "custom:mermaid-card",
              "title": "Schicht 4: Zustand",
              "card_size": 9,
              "content": "flowchart BT\n    AUS[\"Aus\"]\n    SOF[\"Sofortladen\"]\n    UE0[\"Warte\"]\n    UE6[\"6A\"]\n    UE7[\"7A\"]\n    UE8[\"8A\"]\n    UE9[\"9A\"]\n    UE10[\"10A\"]\n    VBM[\"VollBisMorgen\"]\n\n    UE0 -->|\"${if(states['sensor.sim_eff_soc'] >= 20, '-2,84', '-4,14')}\"| UE6\n    UE6 -->|\"${if(states['sensor.sim_eff_soc'] >= 20, '-3,53', '-4,83')}\"| UE7\n    UE7 -->|\"${if(states['sensor.sim_eff_soc'] >= 20, '-4,22', '-5,52')}\"| UE8\n    UE8 -->|\"${if(states['sensor.sim_eff_soc'] >= 20, '-4,91', '-6,21')}\"| UE9\n    UE9 -->|\"${if(states['sensor.sim_eff_soc'] >= 20, '-5,60', '-6,90')}\"| UE10\n    UE10 -->|\"${if(states['sensor.sim_eff_soc'] >= 10, '1,30', '0')}\"| UE9\n    UE9 -->|\"${if(states['sensor.sim_eff_soc'] >= 10, '1,30', '0')}\"| UE8\n    UE8 -->|\"${if(states['sensor.sim_eff_soc'] >= 10, '1,30', '0')}\"| UE7\n    UE7 -->|\"${if(states['sensor.sim_eff_soc'] >= 10, '1,30', '0')}\"| UE6\n    UE6 -->|\"${if(states['sensor.sim_eff_soc'] >= 10, '1,30', '0')}\"| UE0\n\n    classDef active fill:#4CAF50,color:white,stroke:#2E7D32,stroke-width:3px\n    classDef inactive fill:#e0e0e0,color:#666,stroke:#bbb\n\n    class AUS ${if(is_state('sensor.aktiver_knoten','AUS'),'active','inactive')}\n    class SOF ${if(is_state('sensor.aktiver_knoten','SOF'),'active','inactive')}\n    class UE0 ${if(is_state('sensor.aktiver_knoten','UE0'),'active','inactive')}\n    class UE6 ${if(is_state('sensor.aktiver_knoten','UE6'),'active','inactive')}\n    class UE7 ${if(is_state('sensor.aktiver_knoten','UE7'),'active','inactive')}\n    class UE8 ${if(is_state('sensor.aktiver_knoten','UE8'),'active','inactive')}\n    class UE9 ${if(is_state('sensor.aktiver_knoten','UE9'),'active','inactive')}\n    class UE10 ${if(is_state('sensor.aktiver_knoten','UE10'),'active','inactive')}\n    class VBM ${if(is_state('sensor.aktiver_knoten','VBM'),'active','inactive')}"
            },
            {
              "type": "entities",
              "title": "Schicht 5: Aktoren",
              "state_color": true,
              "entities": [
                {
                  "entity": "input_select.aktoren_modus",
                  "name": "Modus"
                },
                {
                  "entity": "input_number.sim_actor_strom",
                  "name": "Wallbox Strom (A)"
                },
                {
                  "entity": "input_boolean.sim_actor_wallbox",
                  "name": "Wallbox aus/ein"
                }
              ]
            }
          ]
        }
      ]
    }
  }
