{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.entw_algo",
  "data": {
    "config": {
      "views": [
        {
          "title": "Simulation",
          "path": "sim",
          "cards": [
            {
              "type": "entities",
              "title": "Schicht 1: Sensoren",
              "state_color": true,
              "entities": [
                {
                  "entity": "input_select.sim_modus_2",
                  "name": "Modus"
                },
                {
                  "entity": "input_number.sim_pv_erzeugung",
                  "name": "PV (kW)"
                },
                {
                  "entity": "input_number.sim_hausverbrauch",
                  "name": "Verbrauch (kW)"
                },
                {
                  "entity": "input_number.sim_netz",
                  "name": "Netz (kW)"
                },
                {
                  "entity": "input_number.sim_batterie_leistung",
                  "name": "Batterie (kW)"
                },
                {
                  "entity": "input_number.sim_batterie_soc",
                  "name": "Batterie (%)"
                },
                {
                  "entity": "input_number.sim_wallbox_strom",
                  "name": "Wallbox Strom (A)"
                },
                {
                  "entity": "input_boolean.sim_wallbox_ein",
                  "name": "Wallbox aus/ein"
                },
                {
                  "entity": "input_select.sim_connector",
                  "name": "Connector"
                }
              ]
            },
            {
              "type": "entities",
              "title": "Schicht 2: Betriebsparameter",
              "state_color": true,
              "entities": [
                {
                  "entity": "input_select.sim_betriebsart",
                  "name": "Betriebsart"
                }
              ]
            },
            {
              "type": "vertical-stack",
              "title": "Schicht 3: Berechnete Sensoren",
              "cards": [
                {
                  "type": "entities",
                  "title": "",
                  "state_color": true,
                  "entities": [
                    {
                      "entity": "sensor.fahrzeug_status",
                      "name": "Fahrzeug"
                    }
                  ]
                },
                {
                  "type": "markdown",
                  "content": "{{ states('sensor.aktuelle_ubergange') }}"
                }
              ]
            },
            {
              "type": "custom:mermaid-card",
              "title": "Schicht 4: Zustand",
              "card_size": 9,
              "content": "flowchart LR\n    AUS[\"Aus\"]\n    SOF[\"Sofortladen\"]\n    UE0[\"Warte\"]\n    UE6[\"Laden\"]\n    UE6+[\"Laden+\"]\n    VBM[\"VollBisMorgen\"]\n\n    AUS --> SOF\n    AUS --> UE0\n    AUS --> VBM\n    SOF --> AUS\n    SOF --> UE0\n    SOF --> VBM\n    VBM --> AUS\n    VBM --> SOF\n    VBM --> UE0\n    UE0 -->|\"sim_netz \u2264 -4.24 (SoC<80%) / \u2264 -4.14 (SoC\u226580%)\"| UE6\n    UE6 -->|\"10s\"| UE6+\n    UE6 -->|\"sim_netz \u2265 0 (SoC<80%) / \u2265 0.1 (SoC\u226580%)\"| UE0\n    UE6+ -->|\"sim_netz \u2265 0 (SoC<80%) / \u2265 0.1 (SoC\u226580%)\"| UE0\n    UE0 --> AUS\n    UE0 --> SOF\n    UE0 --> VBM\n    UE6 --> AUS\n    UE6+ --> AUS\n    UE6 --> SOF\n    UE6+ --> SOF\n    UE6 --> VBM\n    UE6+ --> VBM\n\n    classDef active fill:#4CAF50,color:white,stroke:#2E7D32,stroke-width:3px\n    classDef inactive fill:#e0e0e0,color:#666,stroke:#bbb\n\n    class AUS ${if(is_state('sensor.aktiver_knoten','AUS'),'active','inactive')}\n    class SOF ${if(is_state('sensor.aktiver_knoten','SOF'),'active','inactive')}\n    class UE0 ${if(is_state('sensor.aktiver_knoten','UE0'),'active','inactive')}\n    class UE6 ${if(is_state('sensor.aktiver_knoten','UE6'),'active','inactive')}\n    class UE6+ ${if(is_state('sensor.aktiver_knoten','UE6+'),'active','inactive')}\n    class VBM ${if(is_state('sensor.aktiver_knoten','VBM'),'active','inactive')}"
            },
            {
              "type": "entities",
              "title": "Schicht 5: Aktoren",
              "state_color": true,
              "entities": [
                {
                  "entity": "input_select.aktoren_modus",
                  "name": "Modus"
                },
                {
                  "entity": "input_number.sim_actor_strom",
                  "name": "Wallbox Strom (A)"
                },
                {
                  "entity": "input_boolean.sim_actor_wallbox",
                  "name": "Wallbox aus/ein"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}